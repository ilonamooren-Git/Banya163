---
layout: base.njk
permalink: /praktisch/
eleventyComputed:
  title: "{{ praktisch.title }}"
  description: "{{ praktisch.intro }}"
---
{% set d = praktisch %}
<main class="page">
  <h1>{{ d.title }}</h1>
  <p class="lead">{{ d.intro }}</p>

  <section class="block-sm split">
    <div>
      <h2 style="font-size: 30px; margin-bottom: 16px;">{{ d.rules_title }}</h2>
      <ul class="bullets" style="margin-top: 0; gap: 12px;">{% for r in d.rules %}<li>{{ r }}</li>{% endfor %}</ul>
    </div>
    <div>
      <h2 style="font-size: 30px; margin-bottom: 16px;">{{ d.dog_title }}</h2>
      {{ d.dog_text | paras | safe }}
    </div>
  </section>

  <section class="block">
    <h2 style="font-size: 30px; margin-bottom: 20px;">{{ d.faq_title }}</h2>
    <div class="stack" style="gap: 12px; max-width: 820px;">
      {%- for f in d.faq %}
      <details><summary>{{ f.question }}</summary>{{ f.answer | paras | safe }}</details>
      {%- endfor %}
    </div>
  </section>

  <section id="contact" class="block contact">
    <div>
      <h2>{{ d.contact_title }}</h2>
      <p class="soft" style="margin-bottom: 18px;">{{ d.contact_text }}</p>
      <p style="margin: 0;"><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.phone }}</p>
      <p class="soft" style="margin-top: 14px;">{{ site.name }}<br>{{ site.address | lines | safe }}</p>
    </div>
    <form name="contact" method="POST" action="/bedankt/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact">
      <p class="hidden"><label>Niet invullen <input name="bot-field"></label></p>
      <input class="input" type="text" name="naam" placeholder="Je naam" aria-label="Je naam" required>
      <input class="input" type="email" name="email" placeholder="E-mailadres" aria-label="E-mailadres" required>
      <textarea class="input" name="bericht" rows="4" placeholder="Je bericht" aria-label="Je bericht" required></textarea>
      <button type="submit" class="btn btn-primary">Versturen</button>
    </form>
  </section>
</main>
